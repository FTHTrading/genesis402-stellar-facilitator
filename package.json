{
  "name": "genesis402-stellar-facilitator",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source x402 payment facilitator for Stellar (USDC via Soroban auth entries) with Bazaar-style discovery.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=24" },
  "workspaces": ["packages/*", "examples/*"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false",
    "test": "vitest run",
    "test:testnet": "STELLAR_TESTNET_TESTS=1 vitest run",
    "demo:testnet": "tsx examples/payer/demo.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
