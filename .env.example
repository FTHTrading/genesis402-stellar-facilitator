# Copy to .env (gitignored). Testnet only. Never put a mainnet or Wallet Vault key here.

# --- facilitator (packages/facilitator/src/server.ts) ---
STELLAR_NETWORK=stellar:testnet
# S... secret of the fee-paying settlement account. Generate: node -e "console.log(require('@stellar/stellar-sdk').Keypair.random().secret())"
FACILITATOR_SECRET=
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NONCE_DB_PATH=./facilitator-nonces.sqlite
MAX_TRANSACTION_FEE_STROOPS=50000
PORT=4021

# --- reference seller (examples/reference-seller/src/server.ts) ---
FACILITATOR_URL=http://localhost:4021
SELLER_ADDRESS=
# ASSET_CONTRACT=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA   # Circle testnet USDC (default)

# --- demo (npm run demo:testnet) ---
# Leave these empty and the demo generates fresh testnet keys into examples/payer/demo-keys.json (gitignored).
DEMO_FACILITATOR_SECRET=
DEMO_PAYER_SECRET=
DEMO_SELLER_SECRET=
DEMO_ISSUER_SECRET=
# To pay with Circle's testnet USDC instead of the DEMO asset TUSDC, fund the payer at https://faucet.circle.com (Stellar testnet) and set:
# DEMO_ASSET_CONTRACT=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
# DEMO_ASSET_CODE=USDC
# DEMO_ASSET_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# --- added in review round r1 ---
# Token contracts the facilitator will sponsor (comma-separated). Default: Circle USDC on STELLAR_NETWORK.
ALLOWED_ASSETS=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
# One extra contract for demos only (the TUSDC the demo issues). Never set on a public instance.
DEMO_ASSET=
# Discovery: trust X-Forwarded-For for client identity only behind a proxy that overwrites it.
TRUST_PROXY=0
# Discovery: permit http:// and private crawl targets (local development only).
DISCOVERY_ALLOW_LOCAL=0

# --- added after the threat model (DoS.6, Elevation.4) ---
# Fee-drain guard: total fees the facilitator will sponsor per trailing hour (stroops). Default 5000000 (0.5 XLM).
FEE_BUDGET_STROOPS_PER_HOUR=5000000
# Per-seller (payTo) settlements per trailing hour. Default 600.
MAX_SETTLES_PER_SELLER_PER_HOUR=600
# Seller authentication: comma-separated bearer tokens. Set = /verify and /settle require Authorization: Bearer <token>.
# Unset/empty = open API (self-host default; keep it on the seller's network). Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SELLER_TOKENS=
# Discovery: number of appending proxy hops in front of the process (identity = that many entries from the right of X-Forwarded-For).
TRUST_PROXY_HOPS=1

# --- added in review round r3 ---
# One payTo's (or, in bearer mode, one token's) share of FEE_BUDGET_STROOPS_PER_HOUR.
# Default min(max(floor(budget/4), MAX_TRANSACTION_FEE_STROOPS), budget) = 1250000. An explicit value above the budget refuses to start.
FEE_BUDGET_PER_SELLER_STROOPS_PER_HOUR=1250000
# Reference seller: bearer token for a facilitator running with SELLER_TOKENS (sent as Authorization: Bearer).
FACILITATOR_TOKEN=
# All numeric values above must be plain non-negative integers; separators or units refuse to start.

# --- review round r4 ---
# The per-seller share must not exceed FEE_BUDGET_STROOPS_PER_HOUR (refuses to start). In bearer mode the share follows the token.
# Bearer tokens containing ':' must be given via FACILITATOR_TOKEN (not raw in FACILITATOR_URL).
