# Copy to .env (gitignored). Testnet only. Never put a mainnet or Wallet Vault key here.

# --- facilitator (packages/facilitator/src/server.ts) ---
STELLAR_NETWORK=stellar:testnet
# S... secret of the fee-paying settlement account. Generate: node -e "console.log(require('@stellar/stellar-sdk').Keypair.random().secret())"
FACILITATOR_SECRET=
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NONCE_DB_PATH=./facilitator-nonces.sqlite
MAX_TRANSACTION_FEE_STROOPS=50000
PORT=4021

# --- reference seller (examples/reference-seller/src/server.ts) ---
FACILITATOR_URL=http://localhost:4021
SELLER_ADDRESS=
# ASSET_CONTRACT=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA   # Circle testnet USDC (default)

# --- demo (npm run demo:testnet) ---
# Leave these empty and the demo generates fresh testnet keys into examples/payer/demo-keys.json (gitignored).
DEMO_FACILITATOR_SECRET=
DEMO_PAYER_SECRET=
DEMO_SELLER_SECRET=
DEMO_ISSUER_SECRET=
# To pay with Circle's testnet USDC instead of the DEMO asset TUSDC, fund the payer at https://faucet.circle.com (Stellar testnet) and set:
# DEMO_ASSET_CONTRACT=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
# DEMO_ASSET_CODE=USDC
# DEMO_ASSET_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
